{
	"name": "monaco-rust",
	"version": "0.1.0",
	"private": true,
	"description": "Monaco Editor + Tauri + WASM — a native code editor with hybrid compute architecture",
	"homepage": "https://github.com/solshaskie/Monaco_Rust",
	"author": "solshaskie",
	"license": "MIT",
	"scripts": {
		"prettier-check": "prettier --check .",
		"prettier": "prettier --write .",
		"build-lsp": "cd monaco-lsp-client && npm install && npm run build",
		"build-wasm": "ts-node ./build/wasm/build.script.ts",
		"tauri:prepare": "node ./scripts/prepare-tauri-dist.mjs",
		"tauri:pack": "node ./scripts/package-tauri-artifact.mjs",
		"tauri:dev": "npm run tauri:prepare && cargo tauri dev --config src-tauri/tauri.conf.json",
		"tauri:build": "npm run tauri:prepare && cargo tauri build --config src-tauri/tauri.conf.json",
		"test:rust": "cd src-tauri && cargo test --all-targets",
		"test:wasm": "cd wasm && cargo test",
		"test:e2e": "playwright test --config=test/e2e/playwright.config.ts"
	},
	"dependencies": {
		"monaco-editor": "0.55.1"
	},
	"repository": {
		"type": "git",
		"url": "https://github.com/solshaskie/Monaco_Rust"
	},
	"devDependencies": {
		"@playwright/test": "^1.56.1",
		"@rollup/plugin-alias": "^5.1.1",
		"@rollup/plugin-node-resolve": "^16.0.2",
		"@types/shelljs": "^0.8.11",
		"@types/trusted-types": "^1.0.6",
		"@typescript/vfs": "^1.3.5",
		"@vscode/monaco-lsp-client": "file:./monaco-lsp-client",
		"chai": "^4.3.6",
		"clean-css": "^5.2.4",
		"css-loader": "^6.7.1",
		"esbuild": "^0.25.9",
		"esbuild-plugin-alias": "^0.2.1",
		"file-loader": "^6.2.0",
		"glob": "^7.2.0",
		"http-server": "^14.1.1",
		"husky": "^7.0.4",
		"jsdom": "^29.0.1",
		"jsonc-parser": "^3.0.0",
		"mocha": "^11.7.4",
		"monaco-editor-core": "0.56.0-dev-20260203",
		"parcel": "^2.7.0",
		"pin-github-action": "^1.8.0",
		"postcss-url": "^10.1.3",
		"prettier": "^2.5.1",
		"pretty-quick": "^3.1.3",
		"requirejs": "^2.3.7",
		"rollup": "^4.52.4",
		"rollup-plugin-delete": "^3.0.1",
		"rollup-plugin-dts": "^6.2.3",
		"rollup-plugin-esbuild": "^6.2.1",
		"rollup-plugin-import-css": "^4.0.2",
		"rollup-plugin-keep-css-imports": "^1.0.0",
		"shelljs": "^0.8.5",
		"style-loader": "^3.3.1",
		"terser": "^5.14.2",
		"ts-node": "^10.6.0",
		"tsx": "^4.21.0",
		"typescript": "^5.9.3",
		"vite": "^7.3.2",
		"vscode-css-languageservice": "6.2.14",
		"vscode-html-languageservice": "5.2.0",
		"vscode-json-languageservice": "5.3.11",
		"vscode-languageserver-textdocument": "^1.0.11",
		"vscode-languageserver-types": "3.17.5",
		"vscode-uri": "3.0.8",
		"webpack": "^5.105.4",
		"yaserver": "^0.4.0"
	},
	"alias": {
		"process": false,
		"buffer": false
	},
	"dependencies": {
		"monaco-editor": "0.55.1"
	}
}
